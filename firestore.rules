rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Кто может пользоваться приложением: добавь почту друга в список и нажми Publish.
    function allowed() {
      return request.auth.token.email in [
        "maxbazhenow@gmail.com"
      ];
    }
    // Каждый видит и меняет только свои данные: users/<его uid>/...
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && allowed();
    }
  }
}
